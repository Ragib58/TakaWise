# TakaWise API — copy to apps/api/.env for local development.
# Placeholders only. Never commit real values. Real environments inject variables
# from a secrets manager (blueprint §12).

NODE_ENV=development
PORT=4000
APP_VERSION=0.1.0
APP_BASE_URL=http://localhost:3100
# Comma-separated list of bare origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3100
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
BODY_LIMIT=100kb

# --- Phase 2: database & cache (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql://takawise:takawise_dev_password@localhost:5442/takawise?schema=public
DATABASE_POOL_MAX=10
# Integration tests only (database name must end in _test):
# TEST_DATABASE_URL=postgresql://takawise:takawise_dev_password@localhost:5442/takawise_test?schema=public
REDIS_URL=redis://localhost:6389
# Background jobs (reminders, cleanup) on BullMQ. Required REDIS_URL in production when true.
WORKER_ENABLED=true
# Redis key prefix so environments sharing one Redis never mix jobs.
JOBS_PREFIX=takawise
# Integration tests only:
# TEST_REDIS_URL=redis://localhost:6389

# --- Phase 3: auth (see docs/api/auth.md) ---
# REQUIRED. Each ≥ 32 random characters, different from each other and per environment.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-generate-a-random-48-byte-secret
AUTH_HMAC_SECRET=change-me-generate-a-different-random-secret
# Key rotation window: set to the old JWT_ACCESS_SECRET for ≥ ACCESS_TOKEN_TTL_SECONDS, then remove
# (docs/runbooks/secret-rotation.md).
# JWT_ACCESS_SECRET_PREVIOUS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Secure cookies default to true in production (cannot be disabled there) and false on http://localhost.
# COOKIE_SECURE=true
# Parent domain so app.example.com can read the CSRF cookie set by api.example.com.
# COOKIE_DOMAIN=.example.com
# Number of trusted reverse-proxy hops in front of the API (0 locally).
TRUST_PROXY=0
THROTTLE_ENABLED=true
# Prints OTPs to the console. Only allowed when NODE_ENV=development (boot fails otherwise).
DEV_LOG_OTP=false

# --- Phase 3: email (REQUIRED in production) ---
SMTP_URL=smtp://localhost:1035
EMAIL_FROM=TakaWise <no-reply@takawise.local>

# --- Phase 7: observability ---
# Bearer token for GET /api/v1/metrics (Prometheus). Without it the endpoint is open in dev and 404 in production.
# METRICS_TOKEN=
# Per-instance DB pool: keep DATABASE_POOL_MAX × API instances below the database's max_connections.

# --- v1.1: object storage ---
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_REGION=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=

# --- Phase 9: opt-in AI and OCR (docs/api/ai.md, ADR-024) ---
# Off by default. Nothing is sent to a provider unless AI_ENABLED=true AND the user consented.
AI_ENABLED=false
# none | anthropic | fake  (fake = deterministic offline provider; rejected in production)
AI_PROVIDER=none
# Secret. Inject from the secrets manager; never commit, never put in NEXT_PUBLIC_*.
# AI_PROVIDER_API_KEY=
AI_MODEL=claude-opus-5-5
# Feature flags (comma-separated); anything not listed is off.
AI_FEATURES=MONTHLY_SUMMARY,UNUSUAL_SPENDING,SAVINGS_SUGGESTIONS,TRANSACTION_DRAFT,RECEIPT_OCR
# Rate and cost limits
AI_USER_DAILY_REQUESTS=30
AI_USER_MONTHLY_TOKENS=300000
AI_GLOBAL_DAILY_TOKENS=5000000
AI_TIMEOUT_MS=60000
OCR_MAX_BYTES=4000000

# --- Phase 10: subscriptions & family (docs/api/saas.md, ADR-025/026) ---
# none | fake  (fake = offline signed stand-in for development; rejected in production).
# No real gateway is integrated until merchant approval (docs/launch-checklist.md).
PAYMENT_PROVIDER=none
# Webhook signing secret (>= 32 random chars). Required unless PAYMENT_PROVIDER=none. Never commit.
# PAYMENT_PROVIDER_SECRET=
CHECKOUT_TTL_MINUTES=30
FAMILY_INVITE_TTL_HOURS=168
# First staff admin: pnpm --filter @takawise/api admin:role -- <email> ADMIN
