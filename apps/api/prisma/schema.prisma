// TakaWise database schema (Phase 2).
//
// Conventions
// - UUIDv7 primary keys (time-ordered), generated by Prisma.
// - snake_case tables/columns; camelCase in TypeScript.
// - Money: NUMERIC(20,4) + explicit ISO-4217 currency (ADR-003). Never float.
// - Timestamps: timestamptz(3) in UTC. Financial effective dates: DATE (ADR-012).
// - Posted history is never deleted: FKs to journals/postings are RESTRICT.
// - Cross-user integrity: owned children reference parents by (id, user_id)
//   composite keys, so the database itself rejects mixing two users' rows.
//
// Constraints that Prisma cannot express (CHECKs, partial unique indexes,
// deferred balance trigger, immutability triggers) live in the
// `*_ledger_constraints` migration. See docs/architecture/erd.md.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  runtime                = "nodejs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum Locale {
  EN
  BN
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum FinancialAccountType {
  CASH
  BANK
  MOBILE_WALLET
  SAVINGS
  CREDIT_CARD_TRACKING
  OTHER
}

enum ArchiveStatus {
  ACTIVE
  ARCHIVED
}

enum LedgerAccountClass {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum LedgerSystemCode {
  EQUITY_OPENING_BALANCE
  INCOME
  EXPENSE
}

enum JournalKind {
  OPENING_BALANCE
  INCOME
  EXPENSE
  TRANSFER
  REVERSAL
}

enum JournalStatus {
  POSTED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PostingStatus {
  POSTED
  REVERSED
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum BudgetPeriod {
  MONTHLY
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
}

enum GoalEntryKind {
  CONTRIBUTION
  WITHDRAWAL
  REVERSAL
}

enum ReminderStatus {
  PENDING
  DONE
  CANCELLED
}

enum NotificationKind {
  REMINDER_DUE
  BUDGET_THRESHOLD
  GOAL_ACHIEVED
  SECURITY
  SYSTEM
}

enum FilePurpose {
  RECEIPT
  AVATAR
  EXPORT
  IMPORT
}

enum FileStatus {
  PENDING_UPLOAD
  AVAILABLE
  DELETED
}

// ─────────────────────────── Identity ────────────────────────────

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-cased and trimmed (CHECK users_email_normalized).
  email           String     @unique @db.VarChar(254)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile            UserProfile?
  sessions           Session[]
  verificationTokens VerificationToken[]
  financialAccounts  FinancialAccount[]
  ledgerAccounts     LedgerAccount[]
  journalEntries     JournalEntry[]
  transactions       Transaction[]
  transfers          Transfer[]
  idempotencyKeys    IdempotencyKey[]
  categories         Category[]
  budgets            Budget[]
  savingsGoals       SavingsGoal[]
  goalContributions  GoalContribution[]
  reminders          Reminder[]
  notifications      Notification[]
  files              FileObject[]

  @@map("users")
}

model UserProfile {
  userId          String   @id @map("user_id") @db.Uuid
  fullName        String   @map("full_name") @db.VarChar(120)
  locale          Locale   @default(EN)
  /// IANA timezone used to derive financial effective dates.
  timezone        String   @default("Asia/Dhaka") @db.VarChar(64)
  defaultCurrency String   @default("BDT") @map("default_currency") @db.Char(3)
  avatarFileId    String?  @map("avatar_file_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// Refresh-token session (ADR-011). Only a SHA-256 hash of the token is stored.
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  /// All rotations of one login share a family; reuse revokes the family.
  familyId         String    @map("family_id") @db.Uuid
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipHash           String?   @map("ip_hash") @db.Char(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?   @map("revoked_reason") @db.VarChar(60)
  replacedById     String?   @unique @map("replaced_by_id") @db.Uuid

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy Session? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   Session? @relation("SessionRotation")

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

/// Email-verification / password-reset codes. Only an HMAC of the code is stored.
model VerificationToken {
  id         String              @id @default(uuid(7)) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  purpose    VerificationPurpose
  codeHash   String              @map("code_hash") @db.Char(64)
  attempts   Int                 @default(0)
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?           @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("verification_tokens")
}

// ─────────────────────────── Accounts ────────────────────────────

/// User-facing account (cash, bank, wallet, card...). Balance is never stored;
/// it is derived from the mapped ledger account (ADR-004).
model FinancialAccount {
  id              String               @id @default(uuid(7)) @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  name            String               @db.VarChar(100)
  type            FinancialAccountType
  currency        String               @db.Char(3)
  openingDate     DateTime             @map("opening_date") @db.Date
  /// Informational copy of the opening amount; the OPENING_BALANCE journal is authoritative.
  openingBalance  Decimal              @default(0) @map("opening_balance") @db.Decimal(20, 4)
  institutionName String?              @map("institution_name") @db.VarChar(100)
  /// Credit-card tracking only; metadata, no interest/statement logic in MVP.
  creditLimit     Decimal?             @map("credit_limit") @db.Decimal(20, 4)
  status          ArchiveStatus        @default(ACTIVE)
  archivedAt      DateTime?            @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerAccount     LedgerAccount?
  transactions      Transaction[]
  outgoingTransfers Transfer[]     @relation("TransferSource")
  incomingTransfers Transfer[]     @relation("TransferDestination")
  savingsGoals      SavingsGoal[]

  @@unique([id, userId])
  @@index([userId, status])
  @@map("financial_accounts")
}

// ──────────────────────────── Ledger ─────────────────────────────

/// Seeded catalogue of per-user system ledger accounts (ADR-007).
model LedgerAccountTemplate {
  code          LedgerSystemCode   @id
  class         LedgerAccountClass
  normalBalance NormalBalance      @map("normal_balance")
  nameEn        String             @map("name_en") @db.VarChar(120)
  nameBn        String             @map("name_bn") @db.VarChar(120)

  @@map("ledger_account_templates")
}

/// Chart of accounts. Exactly one of financialAccountId / systemCode is set.
model LedgerAccount {
  id                 String             @id @default(uuid(7)) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  financialAccountId String?            @unique @map("financial_account_id") @db.Uuid
  systemCode         LedgerSystemCode?  @map("system_code")
  class              LedgerAccountClass
  normalBalance      NormalBalance      @map("normal_balance")
  name               String             @db.VarChar(120)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  financialAccount FinancialAccount? @relation(fields: [financialAccountId, userId], references: [id, userId], onDelete: Restrict)
  journalLines     JournalLine[]

  @@unique([id, userId])
  @@unique([userId, systemCode])
  @@unique([financialAccountId, userId])
  @@map("ledger_accounts")
}

/// Immutable once posted (enforced by trigger). Corrections use a REVERSAL entry.
model JournalEntry {
  id            String        @id @default(uuid(7)) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  kind          JournalKind
  status        JournalStatus @default(POSTED)
  effectiveDate DateTime      @map("effective_date") @db.Date
  currency      String        @db.Char(3)
  memo          String?       @db.VarChar(255)
  /// Set only on REVERSAL entries; one reversal per original (unique).
  reversesId    String?       @unique @map("reverses_id") @db.Uuid
  postedAt      DateTime      @default(now()) @map("posted_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  reverses   JournalEntry? @relation("JournalReversal", fields: [reversesId, userId], references: [id, userId], onDelete: Restrict)
  reversedBy JournalEntry? @relation("JournalReversal")
  lines      JournalLine[]

  transaction         Transaction? @relation("TransactionJournal")
  transactionReversal Transaction? @relation("TransactionReversalJournal")
  transfer            Transfer?    @relation("TransferJournal")
  transferReversal    Transfer?    @relation("TransferReversalJournal")

  @@unique([id, userId])
  @@unique([reversesId, userId])
  @@index([userId, effectiveDate])
  @@map("journal_entries")
}

/// Exactly one of debit/credit is > 0 (CHECK). Σdebit = Σcredit per entry is
/// enforced by a deferred constraint trigger at COMMIT (ADR-005).
model JournalLine {
  id              String   @id @default(uuid(7)) @db.Uuid
  journalEntryId  String   @map("journal_entry_id") @db.Uuid
  ledgerAccountId String   @map("ledger_account_id") @db.Uuid
  debit           Decimal  @default(0) @db.Decimal(20, 4)
  credit          Decimal  @default(0) @db.Decimal(20, 4)
  currency        String   @db.Char(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  journalEntry  JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([ledgerAccountId])
  @@map("journal_lines")
}

// ───────────────────── Transactions & transfers ──────────────────

model Transaction {
  id                     String          @id @default(uuid(7)) @db.Uuid
  userId                 String          @map("user_id") @db.Uuid
  journalEntryId         String          @unique @map("journal_entry_id") @db.Uuid
  type                   TransactionType
  status                 PostingStatus   @default(POSTED)
  amount                 Decimal         @db.Decimal(20, 4)
  currency               String          @db.Char(3)
  accountId              String          @map("account_id") @db.Uuid
  categoryId             String          @map("category_id") @db.Uuid
  /// Instant the user says it happened (UTC).
  occurredAt             DateTime        @map("occurred_at") @db.Timestamptz(3)
  /// Local calendar date in the user's timezone; drives budgets/reports.
  effectiveDate          DateTime        @map("effective_date") @db.Date
  description            String?         @db.VarChar(500)
  reversalJournalEntryId String?         @unique @map("reversal_journal_entry_id") @db.Uuid
  reversedAt             DateTime?       @map("reversed_at") @db.Timestamptz(3)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  journalEntry    JournalEntry     @relation("TransactionJournal", fields: [journalEntryId, userId], references: [id, userId], onDelete: Restrict)
  reversalJournal JournalEntry?    @relation("TransactionReversalJournal", fields: [reversalJournalEntryId, userId], references: [id, userId], onDelete: Restrict)
  account         FinancialAccount @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, userId])
  @@unique([reversalJournalEntryId, userId])
  @@index([userId, effectiveDate])
  @@index([userId, type, effectiveDate])
  @@index([userId, accountId, effectiveDate])
  @@index([userId, categoryId, effectiveDate])
  @@index([userId, status])
  @@map("transactions")
}

model Transfer {
  id                     String        @id @default(uuid(7)) @db.Uuid
  userId                 String        @map("user_id") @db.Uuid
  journalEntryId         String        @unique @map("journal_entry_id") @db.Uuid
  status                 PostingStatus @default(POSTED)
  sourceAccountId        String        @map("source_account_id") @db.Uuid
  destinationAccountId   String        @map("destination_account_id") @db.Uuid
  amount                 Decimal       @db.Decimal(20, 4)
  currency               String        @db.Char(3)
  occurredAt             DateTime      @map("occurred_at") @db.Timestamptz(3)
  effectiveDate          DateTime      @map("effective_date") @db.Date
  description            String?       @db.VarChar(500)
  reversalJournalEntryId String?       @unique @map("reversal_journal_entry_id") @db.Uuid
  reversedAt             DateTime?     @map("reversed_at") @db.Timestamptz(3)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  journalEntry       JournalEntry     @relation("TransferJournal", fields: [journalEntryId, userId], references: [id, userId], onDelete: Restrict)
  reversalJournal    JournalEntry?    @relation("TransferReversalJournal", fields: [reversalJournalEntryId, userId], references: [id, userId], onDelete: Restrict)
  sourceAccount      FinancialAccount @relation("TransferSource", fields: [sourceAccountId, userId], references: [id, userId], onDelete: Restrict)
  destinationAccount FinancialAccount @relation("TransferDestination", fields: [destinationAccountId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([journalEntryId, userId])
  @@unique([reversalJournalEntryId, userId])
  @@index([userId, effectiveDate])
  @@index([userId, sourceAccountId])
  @@index([userId, destinationAccountId])
  @@map("transfers")
}

/// Replay protection for financial commands (ADR-006). Written in the same DB
/// transaction as the posting it protects.
model IdempotencyKey {
  userId         String   @map("user_id") @db.Uuid
  key            String   @db.Uuid
  /// e.g. "POST /transactions"
  scope          String   @db.VarChar(64)
  requestHash    String   @map("request_hash") @db.Char(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ─────────────────────────── Planning ────────────────────────────

/// System categories have userId = null, isSystem = true and a stable systemKey.
model Category {
  id         String        @id @default(uuid(7)) @db.Uuid
  userId     String?       @map("user_id") @db.Uuid
  parentId   String?       @map("parent_id") @db.Uuid
  type       CategoryType
  nameEn     String        @map("name_en") @db.VarChar(60)
  nameBn     String        @map("name_bn") @db.VarChar(60)
  icon       String?       @db.VarChar(40)
  isSystem   Boolean       @default(false) @map("is_system")
  systemKey  String?       @unique @map("system_key") @db.VarChar(60)
  sortOrder  Int           @default(0) @map("sort_order")
  status     ArchiveStatus @default(ACTIVE)
  archivedAt DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]    @relation("CategoryTree")
  transactions Transaction[]
  budgetItems  BudgetItem[]

  @@index([userId, type, status])
  @@map("categories")
}

model Budget {
  id            String       @id @default(uuid(7)) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  name          String       @db.VarChar(100)
  period        BudgetPeriod @default(MONTHLY)
  startDate     DateTime     @map("start_date") @db.Date
  endDate       DateTime     @map("end_date") @db.Date
  currency      String       @db.Char(3)
  /// Optional overall limit; category limits live in budget_items.
  overallAmount Decimal?     @map("overall_amount") @db.Decimal(20, 4)
  archivedAt    DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  items BudgetItem[]

  @@unique([id, userId])
  @@index([userId, startDate])
  @@map("budgets")
}

model BudgetItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  budgetId   String   @map("budget_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  amount     Decimal  @db.Decimal(20, 4)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([budgetId, categoryId])
  @@index([categoryId])
  @@map("budget_items")
}

/// Earmark model (ADR-009): progress comes only from goal_contributions.
model SavingsGoal {
  id              String     @id @default(uuid(7)) @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  name            String     @db.VarChar(100)
  targetAmount    Decimal    @map("target_amount") @db.Decimal(20, 4)
  currency        String     @db.Char(3)
  targetDate      DateTime?  @map("target_date") @db.Date
  linkedAccountId String     @map("linked_account_id") @db.Uuid
  status          GoalStatus @default(ACTIVE)
  achievedAt      DateTime?  @map("achieved_at") @db.Timestamptz(3)
  archivedAt      DateTime?  @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  linkedAccount FinancialAccount   @relation(fields: [linkedAccountId, userId], references: [id, userId], onDelete: Restrict)
  contributions GoalContribution[]

  @@unique([id, userId])
  @@index([userId, status])
  @@index([linkedAccountId])
  @@map("savings_goals")
}

/// Append-only. A correction is a REVERSAL row pointing at the original.
model GoalContribution {
  id            String        @id @default(uuid(7)) @db.Uuid
  goalId        String        @map("goal_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  kind          GoalEntryKind
  status        PostingStatus @default(POSTED)
  amount        Decimal       @db.Decimal(20, 4)
  contributedOn DateTime      @map("contributed_on") @db.Date
  note          String?       @db.VarChar(255)
  reversesId    String?       @unique @map("reverses_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  goal       SavingsGoal       @relation(fields: [goalId, userId], references: [id, userId], onDelete: Restrict)
  reverses   GoalContribution? @relation("GoalContributionReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy GoalContribution? @relation("GoalContributionReversal")

  @@index([goalId, contributedOn])
  @@index([userId])
  @@map("goal_contributions")
}

model Reminder {
  id             String         @id @default(uuid(7)) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  title          String         @db.VarChar(120)
  notes          String?        @db.VarChar(1000)
  dueAt          DateTime       @map("due_at") @db.Timestamptz(3)
  /// Timezone the user entered dueAt in, for display.
  timezone       String         @db.VarChar(64)
  /// RFC 5545 RRULE; always null in the MVP (one-time reminders only).
  recurrenceRule String?        @map("recurrence_rule") @db.VarChar(255)
  status         ReminderStatus @default(PENDING)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(3)
  notifiedAt     DateTime?      @map("notified_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status, dueAt])
  @@index([status, dueAt])
  @@map("reminders")
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  kind      NotificationKind
  title     String           @db.VarChar(200)
  body      String?          @db.VarChar(1000)
  payload   Json?
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ─────────────────────── Platform / audit ────────────────────────

/// Transactional outbox (ADR-014): written with the business change, published
/// to BullMQ after commit.
model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  type        String    @db.VarChar(100)
  payload     Json
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.VarChar(1000)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  @@index([processedAt, createdAt])
  @@map("outbox_events")
}

model FileObject {
  id             String      @id @default(uuid(7)) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  objectKey      String      @unique @map("object_key") @db.VarChar(512)
  mimeType       String      @map("mime_type") @db.VarChar(127)
  sizeBytes      BigInt      @map("size_bytes")
  purpose        FilePurpose
  status         FileStatus  @default(PENDING_UPLOAD)
  checksumSha256 String?     @map("checksum_sha256") @db.Char(64)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
  @@map("files")
}

/// Append-only security/financial audit trail. Deliberately has no FKs so it
/// survives account deletion/anonymisation; UPDATE/DELETE blocked by trigger.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Subject user whose data was affected.
  userId     String?  @map("user_id") @db.Uuid
  /// Who performed the action (same as userId for self-service).
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.Uuid
  requestId  String?  @map("request_id") @db.VarChar(128)
  ipHash     String?  @map("ip_hash") @db.Char(64)
  /// Redacted context only — never secrets, tokens or transaction notes.
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
