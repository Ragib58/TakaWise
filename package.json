{
  "name": "takawise",
  "version": "0.1.0",
  "private": true,
  "description": "TakaWise — Bangladesh-first personal finance management SaaS",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" run --if-present build",
    "dev": "pnpm build:packages && pnpm --parallel --filter @takawise/contracts --filter @takawise/api --filter @takawise/web run dev",
    "dev:api": "pnpm build:packages && pnpm --filter @takawise/api run dev",
    "dev:web": "pnpm build:packages && pnpm --filter @takawise/web run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm build:packages && pnpm -r run lint",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "test": "pnpm build:packages && pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "~6.0.3"
  }
}
